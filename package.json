{
  "name": "void-workshop",
  "version": "0.3.0",
  "private": true,
  "description": "VOID Workshop: a local, approval-first AI coding workspace for Linux, powered by the Claude Agent SDK with your own Console API key.",
  "author": "M4S4T0-V01D",
  "homepage": "https://m4s4t0-v01d.github.io/void-workshop/",
  "repository": {
    "type": "git",
    "url": "https://github.com/M4S4T0-V01D/void-workshop.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "./scripts/dev.sh",
    "build": "./scripts/build.sh",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix sidecar run typecheck",
    "lint": "eslint src sidecar/src sidecar/test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"sidecar/{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"sidecar/{src,test}/**/*.ts\"",
    "test": "./scripts/test-gentle.sh",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "diff": "9.0.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
