{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOID Workshop",
  "version": "0.3.0",
  "identifier": "dev.voidworkshop.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "VOID Workshop",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "category": "DeveloperTool",
    "publisher": "M4S4T0-V01D",
    "copyright": "Copyright (c) 2026 M4S4T0-V01D",
    "shortDescription": "Local approval-first AI coding workspace",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
